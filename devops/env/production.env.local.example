# Template for the droplet's /var/www/<domain>/.env.local — Auth.js runtime secrets.
# Upload with `./devops/deploy.sh --env-local <this file, filled in>` or copy it manually.
# Never commit the filled-in version.
# @spec L2-DEVOPS-06

# Generate with `openssl rand -base64 33`.
AUTH_SECRET=change-me

# Behind Caddy the app sits on a proxied host — required.
AUTH_TRUST_HOST=true
AUTH_URL=https://example.com

# Optional: Google login. Works only for emails already registered on the platform.
# Google redirect URI: https://example.com/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional: Google-only mode — disables email + password login.
# Honored only when Google is configured, so a deployment can't lock itself out.
# AUTH_CREDENTIALS_ENABLED=false
