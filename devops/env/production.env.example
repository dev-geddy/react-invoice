# Template for the droplet's /var/www/<domain>/.env — infra + runtime config.
# Upload with `./devops/deploy.sh --env <this file, filled in>` or copy it manually.
# Never commit the filled-in version.
# @spec L2-DEVOPS-06

POSTGRES_USER=backflip
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=backflip
# Dockerized postgres publishes on the droplet's loopback only (127.0.0.1).
POSTGRES_PORT=5432

# App/migrations (host, via pm2) → dockerized db on loopback.
# Keep credentials + port in sync with the POSTGRES_* values above.
DATABASE_URL=postgres://backflip:change-me-strong@127.0.0.1:5432/backflip

# Secret-at-rest key — encrypts stored secrets (AI provider API keys).
# Generate with `openssl rand -base64 32`.
ENCRYPTION_KEY=change-me

# Public domain served by Caddy. Needs a DNS A record → droplet IP.
DOMAIN=example.com
