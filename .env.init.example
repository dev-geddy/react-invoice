# One-off owner seed — copy to `.env.init` (gitignored), then run:
#   corepack yarn init-owner
# Consumed ONLY by that seed script; never injected into the running app.
# Safe to delete `.env.init` after the owner is seeded.
# @spec L2-DB-04

# Platform owner email (required).
ADMIN_EMAIL=you@example.com

# Owner password (optional): omit for a Google-only owner (no passwordHash).
# Re-running init-owner without it preserves any existing password.
ADMIN_PASSWORD=change-me-strong
