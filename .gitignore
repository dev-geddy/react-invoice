# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
playwright-report
test-results
blob-report
.playwright

# next.js
.next/
.next-e2e/
out/

# production
build
dist

# deploy artifacts exported by devops/deploy-for-pm2-build-docker.sh
.artifacts

# turbo
.turbo

# misc
.DS_Store
*.pem

# editors / tooling
.idea/
.claude/*
!.claude/skills/
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.init.example

# external reference repos (cloned for examples, not part of the project)
.external-repos

# local screenshot capture (playwright driver + generated PNGs)
.screenshots

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local credential files
gauth-client-secret*.json
