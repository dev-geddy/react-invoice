# Copy to .env for local development (`.env` is gitignored).
# Postgres runs in Docker (see docker-compose.yml). These values seed that container
# AND are read by the locally-run app.
# @spec L2-INF-07, L2-INF-09

POSTGRES_USER=backflip
POSTGRES_PASSWORD=backflip_local_dev
POSTGRES_DB=backflip
# Host port for the dockerized postgres (kept off the default 5432 to avoid clashes).
POSTGRES_PORT=5544

# App → db connection.
# Local app (yarn dev): db reached on localhost:${POSTGRES_PORT}.
DATABASE_URL=postgres://backflip:backflip_local_dev@localhost:5544/backflip

# Secret-at-rest key — encrypts stored secrets (AI provider API keys).
# Any strong random string, e.g. `openssl rand -base64 32`.
ENCRYPTION_KEY=change-me

# --- Admin owner seed (one-off) ---
# Do NOT put these here. They live in `.env.init` (gitignored) — a one-off file
# consumed ONLY by `corepack yarn init-owner`, never injected into the running app.
# Copy `.env.init.example` → `.env.init`:
#   ADMIN_EMAIL=you@example.com               # required
#   ADMIN_PASSWORD=<a strong random string>   # optional; omit for a Google-only owner

# --- Auth.js secrets (runtime) ---
# Do NOT put these here. They live in `.env.local` (gitignored) — loaded by the
# running app (dev script + docker `env_file`):
#   AUTH_SECRET=<openssl rand -base64 33>
#   AUTH_TRUST_HOST=true
#   AUTH_GOOGLE_ID=<from Google Cloud>   # optional; enables Google login
#   AUTH_GOOGLE_SECRET=<from Google Cloud>
#     Google redirect URI: http://localhost:3070/api/auth/callback/google

# Google-only mode: disable email + password (Credentials) login.
# Only takes effect when Google is configured (otherwise credentials stay on,
# so a deployment can never be locked out). Default: credentials enabled.
#   AUTH_CREDENTIALS_ENABLED=false

# --- Connector (MCP) ---
# @spec L2-MCP-25, L2-MCP-37
# The connector is turned on in the ADMIN UI, not here: /backflip/settings →
# Connectors → Enable. It is a database flag (connector_config.enabled, default
# off) like every other integration. While off, /api/mcp, /api/oauth/*, the
# well-known OAuth metadata docs and /backflip/connect all 404.
#
# MCP_ENABLED is only a deploy-level FORCED-OFF override — for when you need the
# connector dead and can't trust the admin UI (e.g. a compromised owner account).
# Leave it unset for normal operation; the database decides.
#   MCP_ENABLED=false
#
# The OAuth issuer / connector base URL is derived from AUTH_URL (must be the
# public https origin, e.g. https://app.example.com) — set AUTH_URL in
# .env.local for the connector to work. No new secret is needed: connector
# token material is random + SHA-256 hashed, same pattern as other one-time
# tokens, with no ENCRYPTION_KEY dependency.
